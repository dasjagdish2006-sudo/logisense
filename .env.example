# -----------------------------------------------------------------------------
# LogiSense AI — environment template
# Copy to .env and fill in values. Never commit real credentials.
# -----------------------------------------------------------------------------

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_PROXY=http://backend:8000

# Database (PostgreSQL 16)
POSTGRES_USER=logisense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logisense
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://logisense:change-me@postgres:5432/logisense

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI (leave empty to disable; LogiBot is a later phase)
GEMINI_API_KEY=
GROQ_API_KEY=

# Notifications (empty credentials → console/mock mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@logisense.local

# External data (optional; services must fall back if unset)
IMD_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org

# Model health
MODEL_AUC_ALERT_THRESHOLD=0.70

# Financial Shield defaults (INR). Assumptions documented in later phases.
COST_PER_DELAY_HOUR=2500
SLA_PENALTY_PER_SHIPMENT=15000
COLD_CHAIN_LOSS_PER_HOUR=8000
